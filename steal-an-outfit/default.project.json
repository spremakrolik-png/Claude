{
	"name": "StealAnOutfit",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Assets": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false
			}
		},
		"Lighting": {
			"$properties": {
				"Technology": "Future"
			}
		}
	}
}
